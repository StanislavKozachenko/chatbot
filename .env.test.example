# Copy this file to .env.test and fill in your values

# Supabase (same as .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Test user — create once manually in Supabase Dashboard > Authentication > Users
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=your-test-password

# Optional: run tests against a deployed instance instead of localhost
# BASE_URL=https://your-app.vercel.app
